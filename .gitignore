      header {
    border: 1px solid black;
    background-color: #98a;
    padding: 20px 0;
    box-sizing: border-box;
    display: flex;
    justify-content: space-around;
    align-items: center;
}

nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    /* horizontal row */
    border: 2px solid black;
    /* outer border */
}

nav ul li {
    flex: 1;
    /* equal length for all items */
    text-align: center;
    border-right: 2px solid black;
    /* divider between items */
}

nav ul li:last-child {
    border-right: none;
    /* remove border on last item */
}

nav ul li a {
    text-decoration: none;
    /* no underline */
    color: black;
    font-weight: bold;
    display: block;
    /* fills the li box */
    padding: 15px 0;
    /* controls height/length */
}

.logo-box {
    border: 2px solid #333;
    padding: 0.5rem;
    background-color: aliceblue;
}

.logo-box img {
    width: 100px;
    height: auto;
}

h1 {
    text-align: center;
}

.contact-info {
    align-items: stretch;
    text-align: center;
    gap: 2rem;
    margin: 2rem 0;
    order: 2;

}

.company-details {
    flex: 1;
    font-size: 1.1rem;
    line-height: 1.6;
    order: 2;

}

.map {

    flex: 2;
    text-align: left;
    order: 1;
}

.contact-form form {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    align-items: center;
}

.radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.contact-form {
    max-width: 600px;
    margin: 2rem auto;
    text-align: end;
    position: sticky;
}

.contact-form form {
    display: flex;
    /* choose flex OR grid, not both */
    flex-direction: column;
    /* stack label + input vertically */
    gap: 1rem;
    /* consistent spacing */
    align-items: flex-end;
    /* align inputs and labels together */
}